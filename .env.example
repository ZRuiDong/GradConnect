# 复制为 .env，并使用自己的值。应用通过进程环境读取，不会自动加载此文件。
# systemd 会加载 .env；手动命令前使用：set -a; . ./.env; set +a
DJANGO_DEBUG=0
DJANGO_SECRET_KEY='replace-with-a-long-random-secret'
DJANGO_ALLOWED_HOSTS=grad.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://grad.example.edu
DATABASE_URL='postgresql://gradconnect:replace-password@127.0.0.1:5432/gradconnect'
# 云数据库可使用：?sslmode=verify-full&sslrootcert=/srv/gradconnect/certs/root.crt&connect_timeout=5
MEDIA_ROOT=/srv/gradconnect/media
USE_X_ACCEL_REDIRECT=1
